DATABASE_URL=postgresql://postgres:postgres@localhost:54329/clickup
# Direct (non-pooled) connection used by prisma migrate
DIRECT_URL=postgresql://postgres:postgres@localhost:54329/clickup
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
PORT=5000
