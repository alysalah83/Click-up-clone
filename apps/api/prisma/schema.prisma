// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  guest
  /// Fake demo teammate: never logs in, deleted with the guest in `demoOwnerId`.
  demo
}

enum MemberRole {
  owner
  admin
  member
  guest
}

model User {
  id           String      @id @default(uuid())
  role         Role
  hasOnBoarded Boolean?    @default(false)
  name         String?
  email        String?     @unique
  password     String?
  /// Background color token for the initials avatar (null = derived from the id).
  avatarColor  String?
  /// Set on fake demo teammates: the guest they were seeded for (cascade delete).
  demoOwnerId  String?
  /// Pre-seeded guest waiting in the pool (null once claimed). See guestPool.service.ts.
  pooledAt      DateTime?
  /// The seeded Sprint Board a pooled guest lands on.
  landingListId String?
  /// Demo seed version of a pooled guest (see POOL_SEED_VERSION).
  poolSeedVersion Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workspaces   Workspace[]
  lists        List[]
  tasks        Task[]
  statuses     Status[]

  demoOwner      User?             @relation("DemoTeammates", fields: [demoOwnerId], references: [id], onDelete: Cascade)
  demoTeammates  User[]            @relation("DemoTeammates")
  memberships    WorkspaceMember[]
  savedViews     SavedView[]
  docs           Doc[]
  whiteboards    Whiteboard[]
  createdGoals   Goal[]            @relation("GoalCreator")
  ownedGoals     Goal[]            @relation("GoalOwner")
  assignedTasks  TaskAssignee[]
  createdInvites WorkspaceInvite[]
  activities     Activity[]
  timeEntries    TimeEntry[]
  checklistItems ChecklistItem[]
  comments       Comment[]
  attachments    Attachment[]
  taskTemplates  TaskTemplate[]
  commentReactions CommentReaction[]
  commentMentions  CommentMention[]
  notifications  Notification[] @relation("NotificationRecipient")
  actedNotifications Notification[] @relation("NotificationActor")

  @@index([demoOwnerId])
}

model Workspace {
  id          String            @id @default(uuid())
  name        String
  userId      String?
  avatarId    String
  lists       List[]
  members     WorkspaceMember[]
  invites     WorkspaceInvite[]
  tags        Tag[]
  docs        Doc[]
  whiteboards Whiteboard[]
  goals       Goal[]
  taskTemplates TaskTemplate[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user   User?  @relation(fields: [userId], references: [id])
  avatar Avatar @relation(fields: [avatarId], references: [id])

  @@index([userId])
}

model Avatar {
  id        String      @id @default(uuid())
  icon      String
  color     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  workspace Workspace[]
}

model List {
  id          String   @id @default(uuid())
  name        String
  userId      String
  workspaceId String
  tasks       Task[]
  status      Status[]
  automations Automation[]
  savedViews  SavedView[]
  /// Set on sprint lists (null = a regular list). Dates are calendar days at 12:00 UTC.
  sprintNumber Int?
  sprintStart  DateTime?
  sprintEnd    DateTime?
  sprintState  SprintState?
  /// Snapshots taken when the sprint is completed (for velocity): all points vs done points.
  sprintCommittedPoints Int?
  sprintCompletedPoints Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
}

enum SprintState {
  planned
  active
  completed
}

enum Priority {
  urgent
  high
  normal
  low
  none
}

enum RecurrenceType {
  none
  daily
  weekly
  monthly
  custom
}

enum StatusType {
  open
  active
  done
}

model Status {
  id        String     @id @default(uuid())
  name      String
  icon      String
  iconColor String
  bgColor   String
  order     Int
  type      StatusType @default(active)
  isDefault Boolean    @default(false)
  userId    String
  listId    String
  createdAt DateTime   @default(now())
  tasks     Task[]

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([listId, name])
  @@index([userId])
}

model Task {
  id        String         @id @default(uuid())
  userId    String
  name      String
  statusId  String
  priority  Priority       @default(none)
  startDate DateTime?
  endDate   DateTime?
  listId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  assignees TaskAssignee[]
  /// Tiptap (ProseMirror) JSON document.
  description  Json?
  /// Set on subtasks: the parent task (same list). Subtasks are hidden from top-level views.
  parentTaskId String?
  subtasks     Task[]      @relation("Subtasks")
  checklists   Checklist[]
  tags         TaskTag[]
  activities   Activity[]
  comments     Comment[]
  attachments  Attachment[]
  notifications Notification[]
  blockedBy     TaskDependency[] @relation("TaskBlockedBy")
  blocking      TaskDependency[] @relation("TaskBlocks")
  goalTargets   GoalTargetTask[]
  /// Repeat rule: when the task is completed the next occurrence is created. custom = every N days.
  recurrenceType     RecurrenceType @default(none)
  recurrenceInterval Int            @default(1)
  timeEntries        TimeEntry[]
  /// Sprint points (1, 2, 3, 5, 8, 13...).
  points             Int?
  /// When the task last entered a done-type status (null while not done).
  completedAt        DateTime?

  status     Status @relation(fields: [statusId], references: [id], onDelete: NoAction)
  user       User   @relation(fields: [userId], references: [id])
  list       List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  parentTask Task?  @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([parentTaskId])
  @@index([statusId])
  @@index([userId])
}

model WorkspaceMember {
  id          String     @id @default(uuid())
  userId      String
  workspaceId String
  role        MemberRole @default(member)
  createdAt   DateTime   @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model TaskAssignee {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String     @id @default(uuid())
  workspaceId String
  token       String     @unique
  role        MemberRole @default(member)
  expiresAt   DateTime
  createdById String
  createdAt   DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([createdById])
}

model Checklist {
  id        String          @id @default(uuid())
  taskId    String
  name      String
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  items     ChecklistItem[]

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model ChecklistItem {
  id          String   @id @default(uuid())
  checklistId String
  text        String
  done        Boolean  @default(false)
  order       Int      @default(0)
  assigneeId  String?
  createdAt   DateTime @default(now())

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  assignee  User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([checklistId])
  @@index([assigneeId])
}

model Tag {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  color       String
  createdAt   DateTime  @default(now())
  tasks       TaskTag[]

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

/// Who changed what on a task; written by the task services. `data` shape depends on `type`.
model Activity {
  id        String   @id @default(uuid())
  taskId    String
  actorId   String
  type      String
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([actorId])
}

enum NotificationType {
  ASSIGNED
  MENTIONED
  TASK_UPDATED
  COMMENTED
}

/// A task comment. Replies point at a top-level comment via `parentId` (one level of nesting).
model Comment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  parentId  String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]         @relation("CommentReplies")
  reactions CommentReaction[]
  mentions  CommentMention[]
  notifications Notification[]

  @@index([taskId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

/// A file attached to a task, stored on Vercel Blob. Seeded demo files point at public web assets
/// and have an empty `pathname`, so they are never deleted from the blob store.
model Attachment {
  id          String   @id @default(uuid())
  taskId      String
  uploaderId  String
  fileName    String
  contentType String
  size        Int
  url         String
  /// Blob store pathname ("attachments/<workspaceId>/<taskId>/..."); empty for files not on the store.
  pathname    String   @default("")
  createdAt   DateTime @default(now())

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([uploaderId])
}

model CommentReaction {
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId, emoji])
  @@index([userId])
}

model CommentMention {
  commentId String
  userId    String

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  actorId   String
  type      NotificationType
  taskId    String
  commentId String?
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user    User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([taskId])
  @@index([actorId])
  @@index([commentId])
}

/// `task` is blocked by `dependsOn` (a "blocked by" link; both tasks are in the same workspace).
model TaskDependency {
  taskId      String
  dependsOnId String
  createdAt   DateTime @default(now())

  task      Task @relation("TaskBlockedBy", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskBlocks", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
}

/// A per-list rule: when `trigger` fires for a task in the list, run `actions` in order.
model Automation {
  id        String   @id @default(uuid())
  listId    String
  name      String
  enabled   Boolean  @default(true)
  trigger   Json
  actions   Json
  createdAt DateTime @default(now())

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
}

/// A named set of filters + groupBy for a list, owned by one member.
model SavedView {
  id        String   @id @default(uuid())
  listId    String
  userId    String
  name      String
  config    Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listId, userId])
  @@index([userId])
}

/// Time tracked on a task. endedAt is null while the timer runs (one running entry per user).
model TimeEntry {
  id          String    @id @default(uuid())
  taskId      String
  userId      String
  startedAt   DateTime
  endedAt     DateTime?
  /// Computed when the timer stops (or set for manual entries).
  durationSec Int?
  createdAt   DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId, endedAt])
  @@index([startedAt])
}

/// A Notion-style page in a space (workspace). `content` is Tiptap JSON stored as a string.
/// Pages nest through parentId; deleting a page deletes its sub-pages.
model Doc {
  id          String   @id @default(uuid())
  workspaceId String
  parentId    String?
  title       String   @default("")
  icon        String?
  content     String   @default("")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Doc?      @relation("DocTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Doc[]     @relation("DocTree")
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, parentId])
  @@index([createdById])
}

/// An Excalidraw board in a space. `scene` is the serialized scene `{ elements, appState, files }`,
/// or `{ skeleton: true, elements }` for seeded boards that the client converts on first open.
model Whiteboard {
  id          String   @id @default(uuid())
  workspaceId String
  title       String   @default("")
  scene       String   @default("")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([createdById])
}

enum GoalTargetType {
  number
  currency
  boolean
  tasks
}

/// A goal (OKR) in a space. Progress is never stored: it is the average of its targets'
/// progress, computed on read. `dueDate` is a calendar day at 12:00 UTC.
model Goal {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  description String    @default("")
  color       String    @default("violet")
  ownerId     String?
  dueDate     DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?        @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy User         @relation("GoalCreator", fields: [createdById], references: [id], onDelete: Cascade)
  targets   GoalTarget[]

  @@index([workspaceId])
  @@index([ownerId])
  @@index([createdById])
}

/// A key result. Number/currency: start -> target value (`unit` is the currency symbol or a
/// unit label). Boolean: done when currentValue >= 1. Tasks: done linked tasks / linked tasks.
model GoalTarget {
  id           String         @id @default(uuid())
  goalId       String
  name         String
  type         GoalTargetType
  startValue   Float          @default(0)
  currentValue Float          @default(0)
  targetValue  Float          @default(1)
  unit         String?
  order        Int            @default(0)
  createdAt    DateTime       @default(now())

  goal  Goal             @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tasks GoalTargetTask[]

  @@index([goalId])
}

model GoalTargetTask {
  targetId  String
  taskId    String
  createdAt DateTime @default(now())

  target GoalTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  task   Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([targetId, taskId])
  @@index([taskId])
}

/// A reusable task in a space: `snapshot` is the task with its subtasks and checklists, validated by
/// `taskTemplateSnapshotSchema` (@clickup/shared). Templates of every space the user belongs to can
/// be applied in any list they can reach.
model TaskTemplate {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  description String   @default("")
  snapshot    Json
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([createdById])
}
