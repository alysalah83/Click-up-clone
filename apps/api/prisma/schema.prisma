// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  guest
  /// Fake demo teammate: never logs in, deleted with the guest in `demoOwnerId`.
  demo
}

enum MemberRole {
  owner
  admin
  member
  guest
}

model User {
  id           String      @id @default(uuid())
  role         Role
  hasOnBoarded Boolean?    @default(false)
  name         String?
  email        String?     @unique
  password     String?
  /// Background color token for the initials avatar (null = derived from the id).
  avatarColor  String?
  /// Set on fake demo teammates: the guest they were seeded for (cascade delete).
  demoOwnerId  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workspaces   Workspace[]
  lists        List[]
  tasks        Task[]
  statuses     Status[]

  demoOwner      User?             @relation("DemoTeammates", fields: [demoOwnerId], references: [id], onDelete: Cascade)
  demoTeammates  User[]            @relation("DemoTeammates")
  memberships    WorkspaceMember[]
  assignedTasks  TaskAssignee[]
  createdInvites WorkspaceInvite[]

  @@index([demoOwnerId])
}

model Workspace {
  id        String            @id @default(uuid())
  name      String
  userId    String?
  avatarId  String
  lists     List[]
  members   WorkspaceMember[]
  invites   WorkspaceInvite[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user   User?  @relation(fields: [userId], references: [id])
  avatar Avatar @relation(fields: [avatarId], references: [id])

  @@index([userId])
}

model Avatar {
  id        String      @id @default(uuid())
  icon      String
  color     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  workspace Workspace[]
}

model List {
  id          String   @id @default(uuid())
  name        String
  userId      String
  workspaceId String
  tasks       Task[]
  status      Status[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
}

enum Priority {
  urgent
  high
  normal
  low
  none
}

enum StatusType {
  open
  active
  done
}

model Status {
  id        String     @id @default(uuid())
  name      String
  icon      String
  iconColor String
  bgColor   String
  order     Int
  type      StatusType @default(active)
  isDefault Boolean    @default(false)
  userId    String
  listId    String
  createdAt DateTime   @default(now())
  tasks     Task[]

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([listId, name])
  @@index([userId])
}

model Task {
  id        String         @id @default(uuid())
  userId    String
  name      String
  statusId  String
  priority  Priority       @default(none)
  startDate DateTime?
  endDate   DateTime?
  listId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  assignees TaskAssignee[]

  status Status @relation(fields: [statusId], references: [id], onDelete: NoAction)
  user   User   @relation(fields: [userId], references: [id])
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([statusId])
  @@index([userId])
}

model WorkspaceMember {
  id          String     @id @default(uuid())
  userId      String
  workspaceId String
  role        MemberRole @default(member)
  createdAt   DateTime   @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model TaskAssignee {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String     @id @default(uuid())
  workspaceId String
  token       String     @unique
  role        MemberRole @default(member)
  expiresAt   DateTime
  createdById String
  createdAt   DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([createdById])
}
