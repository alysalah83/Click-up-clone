// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  guest
  /// Fake demo teammate: never logs in, deleted with the guest in `demoOwnerId`.
  demo
}

enum MemberRole {
  owner
  admin
  member
  guest
}

model User {
  id           String      @id @default(uuid())
  role         Role
  hasOnBoarded Boolean?    @default(false)
  name         String?
  email        String?     @unique
  password     String?
  /// Background color token for the initials avatar (null = derived from the id).
  avatarColor  String?
  /// Set on fake demo teammates: the guest they were seeded for (cascade delete).
  demoOwnerId  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workspaces   Workspace[]
  lists        List[]
  tasks        Task[]
  statuses     Status[]

  demoOwner      User?             @relation("DemoTeammates", fields: [demoOwnerId], references: [id], onDelete: Cascade)
  demoTeammates  User[]            @relation("DemoTeammates")
  memberships    WorkspaceMember[]
  assignedTasks  TaskAssignee[]
  createdInvites WorkspaceInvite[]
  activities     Activity[]
  checklistItems ChecklistItem[]
  comments       Comment[]
  commentReactions CommentReaction[]
  commentMentions  CommentMention[]
  notifications  Notification[] @relation("NotificationRecipient")
  actedNotifications Notification[] @relation("NotificationActor")

  @@index([demoOwnerId])
}

model Workspace {
  id        String            @id @default(uuid())
  name      String
  userId    String?
  avatarId  String
  lists     List[]
  members   WorkspaceMember[]
  invites   WorkspaceInvite[]
  tags      Tag[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user   User?  @relation(fields: [userId], references: [id])
  avatar Avatar @relation(fields: [avatarId], references: [id])

  @@index([userId])
}

model Avatar {
  id        String      @id @default(uuid())
  icon      String
  color     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  workspace Workspace[]
}

model List {
  id          String   @id @default(uuid())
  name        String
  userId      String
  workspaceId String
  tasks       Task[]
  status      Status[]
  automations Automation[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
}

enum Priority {
  urgent
  high
  normal
  low
  none
}

enum StatusType {
  open
  active
  done
}

model Status {
  id        String     @id @default(uuid())
  name      String
  icon      String
  iconColor String
  bgColor   String
  order     Int
  type      StatusType @default(active)
  isDefault Boolean    @default(false)
  userId    String
  listId    String
  createdAt DateTime   @default(now())
  tasks     Task[]

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([listId, name])
  @@index([userId])
}

model Task {
  id        String         @id @default(uuid())
  userId    String
  name      String
  statusId  String
  priority  Priority       @default(none)
  startDate DateTime?
  endDate   DateTime?
  listId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  assignees TaskAssignee[]
  /// Tiptap (ProseMirror) JSON document.
  description  Json?
  /// Set on subtasks: the parent task (same list). Subtasks are hidden from top-level views.
  parentTaskId String?
  subtasks     Task[]      @relation("Subtasks")
  checklists   Checklist[]
  tags         TaskTag[]
  activities   Activity[]
  comments     Comment[]
  notifications Notification[]
  blockedBy     TaskDependency[] @relation("TaskBlockedBy")
  blocking      TaskDependency[] @relation("TaskBlocks")

  status     Status @relation(fields: [statusId], references: [id], onDelete: NoAction)
  user       User   @relation(fields: [userId], references: [id])
  list       List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  parentTask Task?  @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([parentTaskId])
  @@index([statusId])
  @@index([userId])
}

model WorkspaceMember {
  id          String     @id @default(uuid())
  userId      String
  workspaceId String
  role        MemberRole @default(member)
  createdAt   DateTime   @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model TaskAssignee {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String     @id @default(uuid())
  workspaceId String
  token       String     @unique
  role        MemberRole @default(member)
  expiresAt   DateTime
  createdById String
  createdAt   DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([createdById])
}

model Checklist {
  id        String          @id @default(uuid())
  taskId    String
  name      String
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  items     ChecklistItem[]

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model ChecklistItem {
  id          String   @id @default(uuid())
  checklistId String
  text        String
  done        Boolean  @default(false)
  order       Int      @default(0)
  assigneeId  String?
  createdAt   DateTime @default(now())

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  assignee  User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([checklistId])
  @@index([assigneeId])
}

model Tag {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  color       String
  createdAt   DateTime  @default(now())
  tasks       TaskTag[]

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

/// Who changed what on a task; written by the task services. `data` shape depends on `type`.
model Activity {
  id        String   @id @default(uuid())
  taskId    String
  actorId   String
  type      String
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([actorId])
}

enum NotificationType {
  ASSIGNED
  MENTIONED
  TASK_UPDATED
  COMMENTED
}

/// A task comment. Replies point at a top-level comment via `parentId` (one level of nesting).
model Comment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  parentId  String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]         @relation("CommentReplies")
  reactions CommentReaction[]
  mentions  CommentMention[]
  notifications Notification[]

  @@index([taskId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model CommentReaction {
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId, emoji])
  @@index([userId])
}

model CommentMention {
  commentId String
  userId    String

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  actorId   String
  type      NotificationType
  taskId    String
  commentId String?
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user    User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([taskId])
  @@index([actorId])
  @@index([commentId])
}

/// `task` is blocked by `dependsOn` (a "blocked by" link; both tasks are in the same workspace).
model TaskDependency {
  taskId      String
  dependsOnId String
  createdAt   DateTime @default(now())

  task      Task @relation("TaskBlockedBy", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskBlocks", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
}

/// A per-list rule: when `trigger` fires for a task in the list, run `actions` in order.
model Automation {
  id        String   @id @default(uuid())
  listId    String
  name      String
  enabled   Boolean  @default(true)
  trigger   Json
  actions   Json
  createdAt DateTime @default(now())

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
}
